# Copy to .env to override docker-compose defaults.
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
POSTGRES_DB=bank

# Max number of transfers processed at the same time. Keep below DB_POOL_SIZE.
TX_CONCURRENCY=8
DB_POOL_SIZE=10

# Comma-separated list of origins allowed by CORS.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
